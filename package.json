{
  "name": "sevgorod",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/fira-sans-extra-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans-condensed": "^0.4.1",
    "@expo-google-fonts/patrick-hand-sc": "^0.4.1",
    "@expo-google-fonts/special-elite": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "sh scripts/with-native-env.sh expo start --android",
    "ios": "sh scripts/with-native-env.sh expo start --ios",
    "web": "expo start --web",
    "doctor": "tsx scripts/doctor.ts",
    "android:install": "sh scripts/with-native-env.sh expo run:android --variant release --no-bundler",
    "ios:install": "sh scripts/with-native-env.sh expo run:ios --configuration Release --no-bundler",
    "ios:xcode": "sh scripts/with-native-env.sh expo prebuild --platform ios && xed ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sim": "tsx sim/run.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "private": true
}
