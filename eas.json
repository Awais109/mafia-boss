{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_DEBUG": "0" }
    },
    "tester": {
      "extends": "production",
      "env": { "EXPO_PUBLIC_DEBUG": "1" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal" }
    },
    "tester": {
      "android": { "track": "internal" }
    }
  }
}
